{
  "activation": "implicit",
  "case_id": "adopted-foundation-review",
  "command_assertions": [],
  "description": "An agent-authored foundation proposal explicitly adopted by repository governance can advance before it has a present consumer.",
  "prompt_file": "prompt.md",
  "sandbox": "workspace-write",
  "schema_version": 2,
  "timeout_seconds": 600,
  "trace_assertions": {
    "max_command_executions": 12,
    "max_plan_updates": 1,
    "max_subagent_events": 0,
    "reference_reads_include": [
      "review.md"
    ]
  },
  "workspace_assertions": [
    {
      "path": "REVIEW.md",
      "type": "file_exists"
    },
    {
      "path": "REVIEW.md",
      "type": "file_contains",
      "value": "Goal-integrity verdict: advances."
    },
    {
      "path": "REVIEW.md",
      "type": "file_not_contains",
      "value": "Goal-integrity verdict: research-only."
    },
    {
      "path": "REVIEW.md",
      "type": "file_not_contains",
      "value": "Goal-integrity verdict: diverges."
    },
    {
      "path": "REVIEW.md",
      "type": "file_not_contains",
      "value": "Goal-integrity verdict: authority unclear."
    },
    {
      "path": "REVIEW.md",
      "type": "file_contains",
      "value": "explicitly adopted"
    },
    {
      "paths": [
        "REVIEW.md"
      ],
      "type": "changed_files_exact"
    }
  ],
  "human_review_requirements": [
    "authority: Verify the full report and final response recognize the explicitly adopted foundation scope. Do not reject it solely for lacking a present consumer, or invent authority beyond the adopted decision."
  ]
}
